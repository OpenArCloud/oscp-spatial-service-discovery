# Data storage directory (relative path, mounted into the container)
KAPPA_CORE_DIR=data

# P2P swarm topic prefix for node identification
SWARM_TOPIC_PREFIX=oscpdev_ssd

# Comma-separated ISO country codes this instance manages
COUNTRIES=IT,FI,US

# Service port (default: 8031 when unset)
PORT=8031

# Wider bbox query around the client H3 hex (Turf kilometers). Default: 5
SEARCH_RADIUS_KM=5

# JWT auth on mutating and provider routes (default: true)
AUTH_REQUIRED=true
# Local/dev only: set to false to allow writes without Auth0 (provider becomes "noauthtest")
# AUTH_REQUIRED=false

# Auth0 (required when AUTH_REQUIRED=true)
AUTH0_ISSUER=https://<your_tenant>.auth0.com/
AUTH0_AUDIENCE=https://<your_domain>
